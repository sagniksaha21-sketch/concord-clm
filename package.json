{
  "name": "concord-clm",
  "version": "0.1.0",
  "private": true,
  "description": "Concord \u2014 enterprise Contract Lifecycle Management for Lakm\u0113 Lever: intake, AI-assisted review, approvals, e-signature, obligations and audit.",
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "build": "pnpm -r build",
    "predev": "pnpm --filter @concord/shared build",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @concord/api dev",
    "dev:web": "pnpm --filter @concord/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @concord/api test",
    "check:node": "node scripts/check-node.js",
    "verify": "node scripts/verify.js",
    "security:offline": "node scripts/security-offline.js",
    "e2e:journey": "node scripts/e2e-journey.mjs",
    "ux:check": "node scripts/check-ux.js"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.0.2"
    }
  }
}
