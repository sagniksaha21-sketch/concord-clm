# ─── Concord CLM · environment ───────────────────────────────────────────────
# Copy to `.env` and fill in. With Graph vars unset, the notification service
# runs in DRY-RUN mode: it logs the exact email it *would* send, so the whole
# slice works end-to-end without a Microsoft 365 tenant.

# API
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Server-side target used by the Next.js same-origin /api proxy. In Azure this can
# be the API Container App URL or an internal/private ingress address.
API_INTERNAL_BASE=http://localhost:4000

# ─── Microsoft Graph (Outlook auto-notifications) ────────────────────────────
# App registration in Microsoft Entra ID with application permission Mail.Send
# (admin-consented). See README for the 4-step setup.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Mailbox the notice is sent *from* (UPN of a licensed account or shared mailbox)
GRAPH_SENDER_UPN=clm@lakmelever.com

# ─── Azure OpenAI (AI Review) ────────────────────────────────────────────────
# Optional. Unset → the AI Review service returns the built-in deterministic
# analysis (great for demos). Set these to swap in a live model.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ─── Embeddings (semantic search in the Repository) ──────────────────────────
# Choose how the Repository's natural-language Q&A vectorises text. The default
# costs NOTHING — see docs/deployment.md §9 "Running with no AI cost".
#   local   = deterministic, in-process, offline, FREE (default)
#   ollama  = real vectors from a local Ollama server — FREE, self-hosted
#   bedrock = Amazon Bedrock (Titan) — managed, PAID, NO GPU to run (best on AWS)
#   openai  = OpenAI text-embedding-3-* (managed, PAID)
#   azure   = Azure OpenAI embeddings deployment (managed, PAID)
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_DIM=768                            # set 1024 for Bedrock Titan v2
# EMBEDDINGS_MODEL=nomic-embed-text          # ollama; or text-embedding-3-small (openai)
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=                            # only for EMBEDDINGS_PROVIDER=openai
# AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=        # only for EMBEDDINGS_PROVIDER=azure

# Optional chat model that WRITES the answer from retrieved passages. One switch
# your developers flip — no code change. Unset/none → the best-matching passage
# is returned verbatim (zero cost). Values:
#   CHAT_PROVIDER=ollama  + CHAT_MODEL=llama3.1        → free, local, self-hosted
#   CHAT_PROVIDER=bedrock + BEDROCK_CHAT_MODEL=…       → Amazon Bedrock, managed, no GPU
#   CHAT_PROVIDER=azure   (uses AZURE_OPENAI_* above)  → managed, paid
#   CHAT_PROVIDER=openai  + OPENAI_API_KEY + CHAT_MODEL=gpt-4o-mini → managed, paid
# Unset auto-selects azure when AZURE_OPENAI_* is set, otherwise none.
CHAT_PROVIDER=
CHAT_MODEL=

# ─── Amazon Bedrock (AWS-native managed AI — no GPU box to run) ───────────────
# Use when hosting on AWS: set EMBEDDINGS_PROVIDER=bedrock and/or CHAT_PROVIDER=bedrock.
# Credentials come from the instance IAM role (recommended) or AWS_* keys below.
# Enable model access first in the Bedrock console, and confirm the model IDs for
# your region (some require an inference-profile id, e.g. us.amazon.nova-lite-v1:0).
BEDROCK_REGION=ap-south-1
BEDROCK_EMBEDDINGS_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL=amazon.nova-lite-v1:0
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY reused from the S3 section above.

# ─── OCR for ingestion — four engines, one switch ────────────────────────────
# OCR_PROVIDER: azure | textract | bda | tesseract | none
#   azure     Azure AI Document Intelligence (managed, paid)
#   textract  Amazon Textract (managed, paid, AWS-native)
#   bda       Amazon Bedrock Data Automation (managed, paid, one-service OCR+layout)
#   tesseract FREE, offline — PDF text layer (pdf-parse) + Tesseract for images
#   none      text-layer for txt/md/json + sample fallback (default)
OCR_PROVIDER=
# Azure AI Document Intelligence:
DOC_INTELLIGENCE_ENDPOINT=
DOC_INTELLIGENCE_KEY=
DOC_INTELLIGENCE_API_VERSION=2024-11-30
# Amazon Textract (OCR_PROVIDER=textract): multi-page PDFs OCR'd async from S3
# (needs AWS_S3_BUCKET); images/single-page use sync. Region + creds from below.
# Amazon Bedrock Data Automation (OCR_PROVIDER=bda): needs the doc in S3, plus:
BDA_PROFILE_ARN=
BDA_OUTPUT_S3_URI=
# BDA_PROJECT_ARN=            # optional — a BDA project (custom config)
# BDA_BLUEPRINT_ARN=          # optional — a blueprint for direct field extraction
# Tesseract (OCR_PROVIDER=tesseract, FREE, offline): install the open-source
# binaries once on the box — `apt-get install -y poppler-utils tesseract-ocr`.
# Born-digital PDFs use pdftotext; scans are rasterised + OCR'd; TESSERACT_LANG=eng.
# TESSERACT_LANG=eng

# ─── Extraction model (pulls dates, parties, PAN & GSTIN from OCR text) ───────
# EXTRACT_PROVIDER selects the model: azure | bedrock | openai | none.
# Unset → falls back to CHAT_PROVIDER, then Azure if configured, else a regex
# text-scan. Set EXTRACT_PROVIDER=bedrock for a fully AWS-native pipeline.
EXTRACT_PROVIDER=

# ─── Outlook Actionable Messages (in-Outlook Approve/Reject button) ──────────
# Register the originator in the Actionable Email Developer Dashboard:
#   https://aka.ms/publishoam  — see docs/actionable-message-registration.md
ACTIONABLE_EMAIL_ORIGINATOR=499278d3-6304-4864-9db2-ab4f7e4d106c
# Public HTTPS base URL Outlook will POST the Approve/Reject callback to
# (a tunnel in dev). Also used as the token audience. Falls back to localhost:PORT.
APPROVAL_CALLBACK_URL=
# Comma-separated senders allowed to sign the callback token (optional)
ACTIONABLE_EMAIL_ALLOWED_SENDERS=clm@lakmelever.com
# Token verification on the public approval callback is UNCONDITIONAL in every
# environment — an absent or invalid token is always rejected with 401. The old
# escape hatch below no longer relaxes anything; production refuses to START if
# it is set to false, so a stale config cannot quietly re-open the endpoint.
# ACTIONABLE_ENFORCE_TOKEN=

# ─── Persistence (optional Postgres via Prisma) ──────────────────────────────
# Unset → in-memory stores (reset on restart). Set → intake, templates and
# uploaded documents persist. Then run:
#   pnpm --filter @concord/api db:generate && db:migrate && db:seed
DATABASE_URL=

# ─── Auth (login for the legal team) ─────────────────────────────────────────
AUTH_JWT_SECRET=
# Shared parent domain for HttpOnly auth cookies when web/API use separate subdomains (e.g. .contracts.example.com).
AUTH_COOKIE_DOMAIN=change-me-in-production
SEED_USER_PASSWORD=concord
SEED_USER_EMAIL=
SEED_USER_NAME=
SEED_USER_ROLE=viewer
# The seed script refuses to run against a production database unless this is
# explicitly true AND SEED_USER_PASSWORD is a real value. Seeding a production
# database with known demo accounts is the failure this guard exists to prevent,
# so leave it unset everywhere except a deliberate, supervised bootstrap.
SEED_ALLOW_PROD=false
# Set true only in local/compose environments to seed on startup (the migrate
# job reads this; the API never seeds).
SEED_ON_START=false

# ─── Entra ID SSO (optional — replaces the demo login when set) ──────────────
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:4000/api/auth/sso/callback

# ─── Document storage (originals) ────────────────────────────────────────────
# Provider is picked in order: Google Cloud Storage → Azure Blob → Amazon S3 → local disk.
# On Cloud Run, set GCS_BUCKET and let the attached service account provide
# short-lived credentials through the metadata server. GCS_ACCESS_TOKEN is only
# a local/CI smoke-test hook; never commit or bake a long-lived token into an image.
GCS_BUCKET=
# GCS_ACCESS_TOKEN=
# GCS_API_BASE=https://storage.googleapis.com
# Azure Blob:
# Preferred on Azure: managed identity + Blob Data Contributor on the container.
AZURE_STORAGE_ACCOUNT_URL=
# User-assigned managed identity client ID used for Blob access in production.
AZURE_STORAGE_MANAGED_IDENTITY_CLIENT_ID=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documents
# Amazon S3 (or any S3-compatible store, e.g. MinIO via AWS_S3_ENDPOINT):
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
# AWS_S3_ENDPOINT=                            # only for S3-compatible stores
# AWS_ACCESS_KEY_ID=                          # omit to use the instance IAM role
# AWS_SECRET_ACCESS_KEY=
# Local disk (dev fallback):
STORAGE_LOCAL_DIR=

# ─── Scheduled obligations / renewals digest ─────────────────────────────────
# One Outlook email summarising every key date due in the window. Dormant until
# enabled; sends via Graph (dry-run without a tenant). Trigger on demand any time
# with POST /api/obligations/digest/run.
# Set ENABLED=true to fire on a cadence. Cron is evaluated in SCHEDULE_TZ.
OBLIGATIONS_DIGEST_ENABLED=false
OBLIGATIONS_DIGEST_CRON=0 8 * * *        # daily 08:00
OBLIGATIONS_DIGEST_WINDOW_DAYS=90
OBLIGATIONS_DIGEST_RECIPIENTS=legal@lakmelever.com
# Timezone for all in-app schedulers (digest + nudge)
SCHEDULE_TZ=Asia/Kolkata

# ─── Melento e-signature & digital stamp paper ───────────────────────────────
# Unset → the e-sign flow runs in DEMO/STUB mode (simulates envelopes + e-stamp
# so the whole flow works before Melento's API is available). Set these to go
# live once you have Melento credentials + their API docs (adjust the request
# shapes in esign/melento.service.ts to match their contract).
MELENTO_API_KEY=
MELENTO_BASE_URL=
# Public URL Melento POSTs signing status updates to:
MELENTO_CALLBACK_URL=
# Shared secret to verify the webhook HMAC (X-Melento-Signature). Unset in dev.
MELENTO_WEBHOOK_SECRET=
# Set true only after vendor UAT verifies the exact agreement bytes + SHA-256 are
# transmitted to Melento and the executed artifact can be retrieved/verified.
MELENTO_DOCUMENT_API_VERIFIED=false
# Vendor-UAT gate: executed signed bytes must be retrievable and carry exact source SHA-256 lineage.
MELENTO_EXECUTED_DOCUMENT_API_VERIFIED=false
# Relative vendor API path. {envelopeId} is URL-encoded before substitution.
MELENTO_EXECUTED_DOCUMENT_PATH_TEMPLATE=/v1/envelopes/{envelopeId}/document
# Auto-nudge: remind signatories who haven't signed within the SLA. Dormant until
# enabled; also triggerable on demand via POST /api/esign/nudge/run.
MELENTO_NUDGE_ENABLED=false
MELENTO_NUDGE_AFTER_DAYS=2                # first reminder 2 days after sending
MELENTO_NUDGE_EVERY_DAYS=1               # then re-nudge daily until signed
MELENTO_NUDGE_CRON=0 9 * * *            # daily 09:00 (SCHEDULE_TZ)

# Web (Next.js)
NEXT_PUBLIC_API_BASE=http://localhost:4000

# ═════════════════════════════════════════════════════════════════════════════
# Settings that were load-bearing but undocumented (finding C-D37).
# Every variable below is read somewhere in the code; leaving them out of this
# file is how an operator ends up running production on an unintended default.
# ═════════════════════════════════════════════════════════════════════════════

# ─── Runtime posture ─────────────────────────────────────────────────────────
# production enables the boot security checks, disables demo login and the
# e-sign "advance" simulator, and makes audit writes strict (see below).
NODE_ENV=development
# true = every degraded/fallback mode (dry-run email, stub e-sign, local AI)
# becomes a HARD boot error in production instead of a warning.
PROD_REQUIRE_REAL_INTEGRATIONS=false

# ─── Identity & roles (finding C-D7) ─────────────────────────────────────────
# Comma-separated emails that are ALWAYS platform administrators. Without at
# least one, no one can reach the admin-only role-assignment endpoint, and the
# first approver could only be created with direct SQL.
ADMIN_BOOTSTRAP_EMAILS=
# Canonical role for an SSO user whose claims map to nothing recognised.
# Least privilege: leave as viewer unless you have a reason.
ENTRA_DEFAULT_ROLE=viewer
# Production denies authenticated users with no mapped Concord role by default.
# Keep false; enabling this grants contract:read to any otherwise-unmapped tenant user.
ENTRA_ALLOW_UNMAPPED_VIEWERS=false
# JSON map from an Entra app-role name or GROUP OBJECT ID to a canonical role
# (admin|lead|counsel|approver|viewer). Group claims arrive as GUIDs, which carry
# no meaning on their own — without a mapping those users fall back to the
# default above. Example:
# ENTRA_ROLE_MAP={"Concord.Approvers":"approver","8f2c...-...":"lead"}
ENTRA_ROLE_MAP=
# Demo email/password accounts. Off in production unless explicitly allowed.
AUTH_ALLOW_DEMO_USERS=false
AUTH_DISABLE_DEMO_USERS=false
# Development-only demo identities. They are ignored in production because
# AUTH_ALLOW_DEMO_USERS=true is a production boot error.
DEMO_USER_EMAIL=concord.admin@example.test
DEMO_USER_NAME=Concord Demo Administrator
DEMO_REVIEWER_EMAIL=concord.reviewer@example.test
DEMO_REVIEWER_NAME=Concord Demo Reviewer

# ─── Audit trail (findings C-D1, C-D4, C-D5) ─────────────────────────────────
# Strict = a failed durable audit write throws to the caller instead of being
# swallowed. Defaults to ON in production; set false only with a reason.
# AUDIT_STRICT=
AUDIT_WRITE_RETRIES=3
AUDIT_TX_TIMEOUT_MS=15000
AUDIT_TX_MAX_WAIT_MS=10000
AUDIT_BOOT_TIMEOUT_MS=10000
# Bounds on the read paths so a large trail cannot exhaust memory.
AUDIT_EXPORT_MAX_EVENTS=50000
AUDIT_VERIFY_MAX_EVENTS=100000

# ─── Approvals ───────────────────────────────────────────────────────────────
# How long an approval routing stays valid (hours). Routing is persisted, so
# this survives restarts and applies across replicas.
APPROVAL_ROUTING_TTL_HOURS=720

# ─── Background jobs (finding C-D33) ─────────────────────────────────────────
# Idempotency/claim rows are pruned on this cadence so the table cannot grow
# without bound. Retention only needs to outlive a provider's retry window.
JOB_CLAIM_RETENTION_DAYS=30
JOB_CLAIM_PRUNE_CRON=30 3 * * *

# ─── Timeouts (finding C-D30) ────────────────────────────────────────────────
# Node's fetch has NO default timeout. These bound every outbound call and the
# start-up index build, so a stalled provider cannot hang a request or a boot.
OUTBOUND_HTTP_TIMEOUT_MS=20000
REPOSITORY_INDEX_TIMEOUT_MS=60000
REQUEST_TIMEOUT_MS=30000
ESIGN_WRITE_RETRIES=4

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=10

# ─── Uploads & document security ─────────────────────────────────────────────
UPLOAD_MAX_FILES=5
UPLOAD_MAX_BYTES=26214400
# OOXML ZIP-bomb guards (central-directory validation before OCR/parser use).
UPLOAD_MAX_EXPANDED_BYTES=104857600
UPLOAD_MAX_ZIP_RATIO=80
# true = refuse any upload that could not be malware-scanned.
# UPLOAD_REQUIRE_SCAN makes an unscannable file a REJECTION rather than a pass.
# In production these two settings are checked together at boot: a scanner
# configured without UPLOAD_REQUIRE_SCAN=true is refused, because a file the
# scanner could not verify would otherwise still be stored, OCR'd and indexed.
UPLOAD_REQUIRE_SCAN=false
# Endpoint that accepts the raw bytes by POST and returns a verdict. ClamAV REST
# wrappers, an Azure Function, a Lambda + GuardDuty — anything that answers
# {clean:bool} / {malware:bool} / {infected:bool} or a bare OK/FOUND string.
# Anything NOT positively recognised as clean is treated as not clean.
MALWARE_SCAN_URL=
# Label recorded in the audit trail against each verdict.
MALWARE_SCAN_ENGINE=clamav
# Bearer token, when the scanner requires one.
MALWARE_SCAN_API_KEY=
# Per-file deadline. A scanner that stalls must not hold the upload open.
MALWARE_SCAN_TIMEOUT_MS=15000
CLAMAV_HOST=
# Signed, short-lived links to archived executed copies.
DOWNLOAD_LINK_SECRET=
DOWNLOAD_LINK_TTL_SECONDS=300
# Years an executed copy is retained before it becomes eligible for disposal.
RETENTION_YEARS=8

# ─── Obligations (finding C-D21) ─────────────────────────────────────────────
# Owner attributed to renewal obligations derived from ingested documents.
OBLIGATIONS_DEFAULT_OWNER=legal@lakmelever.com
# How many recent documents the renewal scan reads per request.
OBLIGATIONS_DOC_SCAN_LIMIT=500

# ─── AI guardrails & OCR ─────────────────────────────────────────────────────
# Extractions below this confidence are marked needs-review rather than parsed.
AI_CONFIDENCE_THRESHOLD=0.7
TESSERACT_LANG=eng
# Optional Bedrock Data Automation refinements.
BDA_PROJECT_ARN=
BDA_BLUEPRINT_ARN=

# ─── Storage (AWS) ───────────────────────────────────────────────────────────
# Prefer an IAM role. These are only for local development.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=

# ─── Semantic index ──────────────────────────────────────────────────────────
# false = forbid runtime CREATE TABLE for kb_chunk. The table's column type is
# vector(EMBEDDINGS_DIM), which cannot be pinned in a migration, so with this set
# the operator must create it themselves at the right dimension.
ALLOW_VECTOR_DDL=true

# ─── Demo fixtures — MUST stay false in production ───────────────────────────
# DEMO_SAMPLES replaces real uploaded contracts with hardcoded sample extraction
# data and re-enables the e-sign simulator. Production refuses to start with it on.
DEMO_SAMPLES=false
DEMO_ARCHIVE_SAMPLES=false

# ─── Workspace / Command Center ──────────────────────────────────────────────
# The sidebar asks for its badge counts on every navigation, and one of those
# counts pages the whole Document table. NAV_COUNTS_CACHE_MS is how long a
# computed set of counts is reused before it is recomputed, per role. Lower it
# for fresher badges, raise it if the obligations scan is expensive; 0 disables
# the cache. Default 15000.
NAV_COUNTS_CACHE_MS=15000

# ─── Test harness only (not runtime configuration) ───────────────────────────
# Used by scripts/e2e-journey.mjs.
# WEB_URL=http://localhost:3000
# API_URL=http://localhost:4000
# E2E_EMAIL=sagnik.saha@lakmelever.com
# E2E_PASSWORD=concord
# E2E_SESSION_TOKEN=          # optional short-lived staging session; avoids storing SSO password
# E2E_SSO=false                # true in staging to exercise Microsoft Entra SSO
# REVIEW_PATH=review/CLM-2026-0442
# PLAYWRIGHT_MODULE=playwright-core
# CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# ─── Added after the internal adversarial review of the hardening round ──────
# How long an audit append waits for the chain advisory lock before failing fast.
# Bounded so a queued append cannot hold a pooled DB connection for the whole
# transaction budget (see deployment.md §17.1 on the serialization trade-off).
AUDIT_LOCK_TIMEOUT_MS=5000
# Obligations are composed from live stores; this caches the composition for a
# single request rather than re-scanning per helper call.
OBLIGATIONS_CACHE_MS=2000
# Safety valve on the renewal scan. Hitting it is LOGGED as an error, never a
# silent truncation — obligations beyond it would be invisible in the calendar.
OBLIGATIONS_DOC_SCAN_MAX=100000
# Browser-side request deadline for the web client.
NEXT_PUBLIC_API_TIMEOUT_MS=30000

# ─── Observability (OpenTelemetry) ───────────────────────────────────────────
# OFF by default. With neither of the two exporters below set, the SDK is not
# started at all — no spans, no background timers, no in-memory queue — and the
# boot log and /api/health/ready both say "telemetry: disabled" with the reason.
# That is deliberate: a no-op exporter looks identical to a working one, and
# "monitoring is configured" must never be a claim the system cannot back.
#
# Any OTLP/HTTP collector (OTel Collector, Grafana Agent, Honeycomb, Datadog):
OTEL_EXPORTER_OTLP_ENDPOINT=
# Comma-separated k=v pairs, e.g. "x-honeycomb-team=abc,x-dataset=concord"
OTEL_EXPORTER_OTLP_HEADERS=
# Azure Monitor / Application Insights, as an alternative or in addition:
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Identity the backend groups traces under.
OTEL_SERVICE_NAME=concord-api
OTEL_SERVICE_NAMESPACE=concord
# Set by the container runtime, not by you — it becomes service.instance.id so
# one replica's traces are distinguishable from another's. Listed here only
# because the code reads it.
# HOSTNAME=
# Version stamped on every span, so a regression can be tied to a release.
APP_VERSION=0.1.0
# How often counters are pushed. Lower for a demo, leave at 60s in production.
OTEL_METRIC_EXPORT_INTERVAL_MS=60000
# Verbose SDK diagnostics — use when the collector is not receiving anything.
OTEL_DIAG=false

# Web UI development-only helpers. Leave unset/false in production.
NEXT_PUBLIC_SHOW_DEMO_LOGIN=false
NEXT_PUBLIC_DEMO_EMAIL=

# Development-only sample UI
NEXT_PUBLIC_DEMO_SAMPLES=false

# Development-only e-sign simulator control (server also blocks advance in production).
NEXT_PUBLIC_DEMO_ESIGN_ADVANCE=false

# Maximum extracted characters that may be reviewed as one complete agreement.
# Production fails closed above this value until chunked full-document review is implemented.
AI_REVIEW_MAX_CHARS=120000

# Optional showcase-only opening animation. Keep false in normal production so
# repeat legal users land immediately in their workspace; enable for demos/events.
NEXT_PUBLIC_SHOWCASE_SPLASH=false
