{
  "projectId": "your-project-id",
  "region": "asia-south1",
  "service": "concord",
  "runtimeServiceAccount": "concord-runtime@your-project-id.iam.gserviceaccount.com",
  "migrationServiceAccount": "concord-migrate@your-project-id.iam.gserviceaccount.com",
  "cloudSqlInstance": "your-project-id:asia-south1:concord",
  "bucket": "concord-documents-your-project-id",
  "webOrigin": "https://concord.example.com",
  "apiImage": "asia-south1-docker.pkg.dev/your-project-id/concord/concord-api:RELEASE",
