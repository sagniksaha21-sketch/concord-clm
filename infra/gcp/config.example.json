  "inferenceLocation": "SET_APPROVED_LOCATION",
  "geminiModel": "SET_APPROVED_MODEL",
  "documentAiLocation": "SET_APPROVED_PROCESSOR_LOCATION",
  "documentAiProcessor": "SET_PROCESSOR_ID",
  "documentAiProcessorVersion": "SET_PROCESSOR_VERSION",
