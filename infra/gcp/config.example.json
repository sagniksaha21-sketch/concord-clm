    "AUTH_JWT_SECRET": { "name": "concord-auth-jwt", "version": "1" },
    "ENTRA_CLIENT_SECRET": { "name": "concord-entra-client-secret", "version": "1" },
    "AZURE_CLIENT_SECRET": { "name": "concord-graph-client-secret", "version": "1" },
    "MELENTO_API_KEY": { "name": "concord-melento-api-key", "version": "1" },
    "MELENTO_WEBHOOK_SECRET": { "name": "concord-melento-webhook", "version": "1" }
  },
  "migrationDatabaseSecret": { "name": "concord-migration-database-url", "version": "1" },
  "extraEnv": {}
