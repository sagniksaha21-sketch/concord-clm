// Concord CLM · Prisma schema
// Activated when DATABASE_URL is set. Run `pnpm db:generate` then
// `pnpm db:migrate` and `pnpm db:seed`. Without a DB the API uses in-memory
// stores seeded from @concord/shared.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  name     String
  // Least privilege by default. A user whose identity-provider claims map to
  // nothing recognised must not inherit write or approval rights.
  role     String @default("viewer")
  // 'sso'       — taken from Entra app-role/group claims, refreshed on sign-in
  // 'manual'    — set by an administrator here; SSO must not overwrite it
  // 'bootstrap' — from ADMIN_BOOTSTRAP_EMAILS configuration
  roleSource String @default("sso")
  password  String // bcrypt hash
  createdAt DateTime @default(now())
  raisedRequests IntakeRequest[] @relation("RequestClient")
  assignedRequests IntakeRequest[] @relation("RequestLawyer")
  inboxNotifications RequestNotification[]
  requestAttachments RequestAttachment[]
  requestMessages RequestMessage[]
  ownedAgreements Contract[] @relation("AgreementOwner")
}

model Template {
  id           String   @id
  name         String
  contractType String
  description  String
  clauseIds    String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Clause {
  id               String  @id
  title            String
  category         String
  text             String
  playbookStandard Boolean @default(true)
}

model IntakeRequest {
  id                  String   @id
  title               String
  counterparty        String
  businessUnit        String
  requestor           String
  contractType        String
  description         String
  suggestedTemplateId String?
  triageRisk          String?
  status              String   @default("new")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
  requesterId         String?
  requester           User? @relation("RequestClient", fields: [requesterId], references: [id], onDelete: Restrict)
  assignedLegalUserId  String?
  assignedLegal       User? @relation("RequestLawyer", fields: [assignedLegalUserId], references: [id], onDelete: Restrict)
  contractId          String? @unique
  contract            Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  submissionKey       String? @unique
  payloadHash         String?
  terms               Json?
  requestedByDate     String?
  urgency             String @default("standard")
  clientStatus        String @default("submitted")
  legalNote           String?
  version             Int @default(0)
  notifications       RequestNotification[]
  attachments         RequestAttachment[]
  messages            RequestMessage[]
  assignmentPreference String?
  @@index([requesterId, createdAt])
  @@index([assignedLegalUserId, clientStatus])
}

model Contract {
  obligationExtractions ObligationExtraction[]
  id String @id
  title String
  counterparty String
  type String
  valueDisplay String
  stage String
  risk String
  version String
  source String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents Document[]
  intakeRequest IntakeRequest?
  executedAt DateTime?
  authoritativeArchiveId String?
  lifecycleRevision Int @default(0)
  draft AgreementDraft?
  obligations AgreementObligation[]
  notifications RequestNotification[]
  approvalSteps ApprovalStep[]
  approvalHistory ApprovalRound[]
  ownerId String?
  owner User? @relation("AgreementOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  versions AgreementVersion[]
  comments AgreementComment[]
  negotiationRounds NegotiationRound[]
  guestInvitations GuestInvitation[]
  parentAgreementId String?
  parentAgreement Contract? @relation("AmendmentParent", fields: [parentAgreementId], references: [id], onDelete: Restrict)
  amendments Contract[] @relation("AmendmentParent")
  needsNewVersion Boolean @default(false)
  negotiationState String?
  agreedDocumentId String?
  agreedSha256 String?
  agreedAt DateTime?
  agreedBy String?
  @@index([counterparty])
  @@index([stage])
  @@index([risk])
}

// Prior approval rounds are append-only snapshots. Current routing/decision
// tables remain compatible read indexes for the active contract version.
model ApprovalRound {
  id String @id
  contractId String
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  contractVersion String
  evidence Json
  evidenceSha256 String
  createdAt DateTime @default(now())
  @@unique([contractId, contractVersion])
}

model RequestAttachment {
  id String @id
  uploaderId String
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  requestId String?
  request IntakeRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  filename String
  size Int
  category String
  contentType String
  storageKey String
  sha256 String
  createdAt DateTime @default(now())
  @@index([uploaderId, requestId])
}

model RequestMessage {
  id String @id
  requestId String
  request IntakeRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  kind String
  body String
  createdAt DateTime @default(now())
  @@index([requestId, createdAt])
}

model AgreementDraft {
  contractId String @id
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  templateId String?
  sections Json
  model String
  revision Int @default(1)
  documentId String
  updatedBy String
  updatedAt DateTime @updatedAt
}

model AgreementObligation {
  extractionKey String? @unique
  id String @id
  contractId String
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  title String
  type String
  dueDate String
  ownerEmail String?
  sourceArchiveId String
  evidence String
  confirmed Boolean @default(false)
  completedAt DateTime?
  createdAt DateTime @default(now())
  @@index([contractId, dueDate])
}

// A durable personal inbox and Outlook outbox, committed with the request.
model RequestNotification {
  id             String @id
  requestId      String?
  request        IntakeRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  contractId     String?
  contract       Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  recipientId    String
  recipient      User @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  kind           String
  title          String
  body           String
  emailStatus    String @default("queued")
  attempts       Int @default(0)
  nextAttemptAt  DateTime @default(now())
  leaseUntil     DateTime?
  claimToken     String?
  lastError      String?
  sentAt         DateTime?
  readAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([requestId, recipientId, kind])
  @@unique([contractId, recipientId, kind])
  @@index([recipientId, readAt, createdAt])
  @@index([emailStatus, nextAttemptAt])
}

model Document {
  id           String   @id @default(cuid())
  contractId   String?
  contract     Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  filename     String
  documentType String?
  pages        Int?
  confidence   Int
  status       String
  extraction   Json
  validations  Json
  notes        String[]
  model        String
  blobPath     String?
  extractedText String?
  sha256       String?
  createdAt    DateTime @default(now())
  versionRecord AgreementVersion?
  @@index([contractId])
}

model AgreementVersion {
  documentId String @id
  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  contractId String
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  number Int
  label String
  authorName String
  authorUserId String?
  authorGuestId String?
  organisation String?
  source String
  reason String
  stage String
  round Int @default(0)
  sections Json?
  changeSummary Json?
  sharedAt DateTime?
  agreedAt DateTime?
  approvedAt DateTime?
  executedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([contractId, number])
}

model AgreementComment {
  id String @id
  contractId String
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  documentId String
  sectionId String?
  authorUserId String?
  authorGuestId String?
  authorName String
  visibility String @default("internal")
  body String
  parentId String?
  resolvedAt DateTime?
  resolvedBy String?
  createdAt DateTime @default(now())
  @@index([contractId, documentId, visibility])
}

model NegotiationRound {
  id String @id
  contractId String
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  documentId String
  sha256 String
  sections Json
  number Int
  createdBy String
  createdAt DateTime @default(now())
  invitations GuestInvitation[]
  responses NegotiationResponse[]
  @@unique([contractId, documentId])
  @@unique([contractId, number])
}

model GuestInvitation {
  version Int @default(1)
  executedArchiveId String?
  executedSharedAt DateTime?
  id String @id
  requestHash String
  contractId String
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  roundId String
  round NegotiationRound @relation(fields: [roundId], references: [id], onDelete: Restrict)
  name String
  email String
  organisation String
  invitedBy String
  expiresAt DateTime
  responseDueAt DateTime?
  allowDownload Boolean @default(false)
  allowRedline Boolean @default(true)
  allowUpload Boolean @default(true)
  revokedAt DateTime?
  viewedAt DateTime?
  acceptedDocumentId String?
  challengeId String?
  otpHash String?
  otpExpiresAt DateTime?
  otpAttempts Int @default(0)
  otpSentAt DateTime?
  otpDelivery String?
  createdAt DateTime @default(now())
  sessions GuestSession[]
  responses NegotiationResponse[]
  deliveries GuestDelivery[]
  @@index([contractId, expiresAt])
}

model GuestSession {
  hash String @id
  invitationId String
  invitation GuestInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([invitationId])
}

model GuestAuthLimit {
  id String @id
  count Int @default(1)
  expiresAt DateTime
}

model NegotiationResponse {
  analysis NegotiationAnalysis?
  id String @id
  requestHash String
  invitationId String
  invitation GuestInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  roundId String
  round NegotiationRound @relation(fields: [roundId], references: [id], onDelete: Restrict)
  documentId String
  sections Json
  originalSections Json
  changes Json
  source String
  state String @default("received")
  reviewedBy String?
  reviewedDocumentId String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([invitationId, roundId])
}

model NegotiationAnalysis {
  responseId String @id
  response NegotiationResponse @relation(fields: [responseId], references: [id], onDelete: Restrict)
  status String @default("queued")
  assessments Json?
  model String?
  sourceSha256 String?
  detail String?
  claimToken String?
  leaseUntil DateTime?
  updatedAt DateTime @updatedAt
  @@index([status, updatedAt])
}

model GuestDelivery {
  id String @id
  invitationId String
  invitation GuestInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  roundId String
  kind String
  status String @default("queued")
  attempts Int @default(0)
  claimToken String?
  leaseUntil DateTime?
  nextAttemptAt DateTime @default(now())
  createdAt DateTime @default(now())
  @@unique([invitationId, roundId, kind])
  @@index([status, nextAttemptAt])
}

model SignatureRequest {
  id            String    @id
  contractId    String
  contractTitle String
  status        String
  provider      String
  envelopeId    String?
  signingUrl    String?
  message       String?
  signatories   Json
  stampPaper    Json?
  audit         Json
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
  completedAt   DateTime?
  lastNudgedAt  DateTime?
  documentId     String?
  documentSha256 String?
  contractVersion String?
  // Optimistic concurrency (finding C-D15). Every state change is a
  // read-modify-write of the whole row; without a version, two webhooks that
  // interleave silently erase each other's signature events.
  version       Int       @default(0)

  @@index([envelopeId])
  @@unique([contractId, contractVersion, documentId])
}

///
/// Who a contract was routed to for approval (finding C-D6).
///
/// This lived in a per-process Map, so a restart, a deploy, or a callback landing
/// on a different replica left the legitimate approver with a 403 and no way in.
model ApprovalRouting {
  contractId String   @id
  approvers  String[]
  stage      String   @default("approval")
  routedBy   String?
  routedAt   DateTime @default(now())
  expiresAt  DateTime
  documentId String?
  documentSha256 String?
  contractVersion String?
  recommendation String?
  policyEvidence Json?

  @@index([expiresAt])
}

model ApprovalPolicy {
  id String @id
  name String
  enabled Boolean @default(true)
  revision Int @default(1)
  conditions Json
  approvers String[]
  updatedBy String
  updatedAt DateTime @updatedAt
}

model ApprovalStep {
  id String @id
  contractId String
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  approverEmail String
  approverName String
  reason String
  decision String @default("pending")
  comment String?
  decidedAt DateTime?
  @@unique([contractId, approverEmail])
}

///
/// The first (and only) approval decision for a contract (finding C-D8).
///
/// The decision is written here in the same atomic statement that claims the
/// one-shot slot, so a crash between "claim" and "record" can no longer lose a
/// legally significant decision while permanently locking out the approver.
model ApprovalDecision {
  contractId String   @id
  decision   String
  decidedBy  String
  comment    String?
  tokenVerified Boolean @default(true)
  documentId String?
  documentSha256 String?
  contractVersion String?
  decidedAt  DateTime @default(now())
}

///
/// Cross-replica one-shot claims (idempotency + "exactly one replica runs this
/// sweep"). Previously created by runtime `CREATE TABLE IF NOT EXISTS`, which
/// kept it out of migrations and out of drift checking (finding C-D33).
model JobClaim {
  key       String   @id @map("claim_key")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("job_claim")
  @@index([createdAt])
}

/// Per-run claim for the scheduled obligations digest (see JobClaim).
model DigestRun {
  key       String   @id @map("run_key")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("digest_run")
  @@index([createdAt])
}

model ArchivedDocument {
  obligationExtraction ObligationExtraction?
  id                 String   @id
  requestId          String   @unique
  contractId         String
  contractTitle      String
  signatories        Json
  stampCertificateNo String?
  stampState         String?
  completedAt        DateTime
  archivedAt         DateTime @default(now())
  storageKey         String
  checksum           String
  format             String
  filename           String?
  size               Int
  retentionUntil     DateTime?
  legalHold          Boolean   @default(false)
}

///
/// High-water mark for the audit chain.
///
/// The hash chain proves that the events which REMAIN have not been edited or
/// re-ordered. On its own it cannot detect DELETION: truncate the table and a
/// chain walk finds nothing wrong to report, so verification would happily
/// attest "chain intact — 0 events". This single row records the highest seq and
/// hash ever committed, written inside the same transaction as the append, so a
/// tip that has gone backwards is detectable.
///
/// It raises the bar; it is not a substitute for a database role that holds only
/// INSERT + SELECT on the audit tables and WAL shipped to write-once storage,
/// both of which are in the deployment guide. Anyone able to edit AuditEvent can
/// also edit this row.
model AuditAnchor {
  id        String   @id @default("chain")
  seq       Int
  hash      String
  updatedAt DateTime @updatedAt
}

// Immutable, hash-chained audit trail (assessment finding C2).
// Append-only: the application never issues UPDATE or DELETE against this table.
// In production, lock it down further with a DB role that holds INSERT + SELECT
// only, and ship WAL to write-once storage for regulator-grade immutability.
model AuditEvent {
  id         String   @id
  seq        Int      @unique
  at         DateTime @default(now())
  actorId    String?
  actorEmail String?
  actorRole  String?
  action     String
  entity     String
  entityId   String?
  summary    String
  request       Json?
  metadata      Json?
  ai            Json?
  correlationId String?
  prevHash      String
  hash          String   @unique

  @@index([entity, entityId])
  @@index([action])
  @@index([at])
}

model ObligationExtraction {
  archiveId String @id
  archive ArchivedDocument @relation(fields: [archiveId], references: [id], onDelete: Restrict)
  contractId String
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  status String @default("queued")
  source String?
  model String?
  detail String?
  claimToken String?
  leaseUntil DateTime?
  updatedAt DateTime @updatedAt
  @@index([status, updatedAt])
}
