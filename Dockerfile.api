# Concord CLM · API image (NestJS)
FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @concord/shared build \
 && pnpm --filter @concord/api db:generate \
 && pnpm --filter @concord/api build

FROM node:22-bookworm-slim AS run
WORKDIR /app
ENV NODE_ENV=production \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable
# The migration Container Apps job intentionally uses this same image and needs
# the Prisma CLI, so the workspace install is retained until migration is split
# into its own minimal image. The process itself runs as the unprivileged node user.
COPY --from=build --chown=node:node /app /app
USER node
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4000/api/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "apps/api/dist/main.js"]
